# ================================
# Unity Project Ignore Rules
# ================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# Asset Store / Package artifacts
Assets/AssetStoreTools*
GeneratedAssets/

# Autogenerated IDE files & Solution files
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity package / build artifacts
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.app
*.unitypackage
~UnityDirMonSyncFile~*

# OS generated files
.DS_Store*
Thumbs.db
Desktop.ini

# PlasticSCM
.plastic/
ignore.conf

# ================================
# Secrets, Credentials & API Keys
# ================================
# Environment files (across all directories)
.env
.env.*
*.env
**/.env
**/.env.*
# Allow example environment templates
!**/.env.example
!**/.env.template

# API keys & token files
*api_key*
*apikey*
*.token
*.tokens

# Cloud, Auth & Credential configuration files
credentials.json
**/credentials.json
secrets.json
**/secrets.json
client_secret*.json
**/client_secret*.json
service-account*.json
**/service-account*.json
google-services.json
**/google-services.json
GoogleService-Info.plist
**/GoogleService-Info.plist

# Cryptographic Keys, Certificates & Keystores (Android/iOS signing)
*.pem
*.key
*.pfx
*.p12
*.keystore
*.jks
*.id_rsa
*.id_ed25519

# ================================
# Python & Agents Ignore Rules
# ================================
agents/__pycache__/
*.pyc
*.pyo
agents/output/*.cache
